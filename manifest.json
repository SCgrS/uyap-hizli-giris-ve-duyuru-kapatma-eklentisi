{
  "manifest_version": 3,
  "name": "UYAP Hızlı Giriş ve Duyuru Kapatma",
  "version": "4.3",
  "description": "Duyuruyu kapatır, E-imza ile girişe tıklar ve Pin alanına odaklanır.",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://avukat.uyap.gov.tr/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}